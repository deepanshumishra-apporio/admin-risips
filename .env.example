# Server-side only — the browser never talks to the API directly, so nothing
# here is NEXT_PUBLIC_. Copy to .env.local for development.

# Origin of the RiSips API (backend/). No trailing slash.
ADMIN_API_URL=http://74.225.175.227:3000

# The API's DASHBOARD_PROXY_KEY. With it, the API believes the visitor IP this
# server passes on, which it needs to record a karta's HUF consent. On Vercel
# the API is behind Caddy, which otherwise hides that IP.
# ADMIN_API_PROXY_KEY=
